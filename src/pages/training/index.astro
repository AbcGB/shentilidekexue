---
import Base from '../../layouts/Base.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import QuickAnswer from "../../components/QuickAnswer.astro";
import { training, siteUrl, site } from '../../lib/data';
import { u } from '../../lib/url';
const t: any = training;
const jsonLd = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'Course', name: t.title, description: t.intro, inLanguage: 'zh-CN', provider: { '@type': 'Organization', name: site.brand, url: siteUrl() + '/' }, url: siteUrl() + '/training/' },
  ...t.courses.map((c: any) => ({ '@type': 'Course', name: `${t.title}·${c.name}（${c.lead}）`, description: c.desc, inLanguage: 'zh-CN', provider: { '@type': 'Organization', name: site.brand }, instructor: { '@type': 'Person', name: c.lead } })),
] };
---
<Base title="皮穿支针刺培训：牛老师小课与丁志伟老师大课" path="/training/" jsonLd={jsonLd} description="皮穿支针刺培训分为牛老师小课（基础教学）和丁志伟老师大课（核心技术讲解），以线下实操为主，内容涵盖皮穿支解剖、皮门多普勒设备操作、穴位定位和针刺操作。具体安排请咨询。" keywords={['皮穿支针刺培训', '皮穿支培训', '牛老师小课', '丁志伟大课', '丁志伟', '皮门多普勒培训', '穴位定位培训', '身体里的科学']}>
  <div class="container">
    <div class="breadcrumb"><a href={u('/')}>首页</a> › 皮穿支针刺培训</div>
    <h1>{t.title}</h1>
    <p class="lead">{t.intro}</p>
    <QuickAnswer ids={["training"]} links={false} />
    <div class="cta-row" style="margin:14px 0">
      <a class="btn btn-lg" href={u('/contact/training/')}>了解培训 / 课程咨询</a>
      <a class="btn btn-lg btn-outline" href={u('/equipment/')}>了解皮门多普勒设备</a>
    </div>

    <section class="detail-section" id="courses">
      <h2>小课与大课</h2>
      <div class="biz-grid">
        {t.courses.map((c: any) => (
          <article class="biz-card course-card" id={`course-${c.id}`} data-course={c.id}>
            <p class="course-tag">{c.name} · {c.focus}</p>
            <h3 style="margin:2px 0 6px">{c.lead}{c.name}</h3>
            <p>{c.desc}</p>
            <div class="table-wrap"><table><tbody>{c.arrangement.map((r: any) => <tr><th style="width:7em">{r.k}</th><td>{r.v}</td></tr>)}</tbody></table></div>
            <div class="cta-row"><a class="btn btn-sm" href={u(`/contact/training/?course=${c.id}`)}>咨询{c.name}</a></div>
          </article>
        ))}
      </div>
    </section>

    <section class="detail-section">
      <h2>怎么开课</h2>
      <ol>{t.howItWorks.map((s: string) => <li>{s}</li>)}</ol>
    </section>

    <section class="detail-section">
      <h2>适合谁来学</h2>
      <ul>{t.audience.map((a: string) => <li>{a}</li>)}</ul>
    </section>

    <section class="detail-section">
      <h2>课程方向</h2>
      <p class="small muted">完整大纲、课时和授课安排以负责人正式发布为准。</p>
      <div class="biz-grid">{t.modules.map((m: any) => <div class="card"><h3 style="margin:0 0 4px">{m.name}</h3><p style="margin:0">{m.desc}</p></div>)}</div>
    </section>

    <section class="detail-section">
      <h2>学之前可以先看</h2>
      <ul>
        <li><a href={u('/xuewei/')}>人体穴位知识中心</a>：常用穴位的标准定位、取穴方法和皮门多普勒定位演示。</li>
        <li><a href={u('/equipment/')}>皮门多普勒设备</a>：当前设备、操作过程和设备迭代。</li>
        <li><a href={u('/xuexi/')}>皮穿支学习路径</a>：6 课讲清皮穿支的解剖基础。</li>
      </ul>
    </section>

    <section class="consult-strip" style="margin-top:24px">
      <h2>想参加皮穿支针刺培训？</h2>
      <p>说明所在省市、想了解小课还是大课，开课时间、地点和费用具体安排请咨询。</p>
      <div class="cta-row" style="justify-content:center"><a class="btn" href={u('/contact/training/')}>培训咨询</a></div>
    </section>
    <div style="margin-top:16px"><ContactBlock headingLevel={2} /></div>
  </div>
</Base>
