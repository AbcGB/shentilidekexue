---
import Base from '../../layouts/Base.astro';
import LessonProgress from '../../components/LessonProgress.astro';
import QuickAnswer from '../../components/QuickAnswer.astro';
import qa from '../../content/quick-answers.json';
import { getLessons, site, siteUrl } from '../../lib/data';
import { u } from '../../lib/url';
const lessons = getLessons();
const order = lessons.map((l) => ({ slug: l.slug, title: l.title, href: u(`/xuexi/${l.slug}/`) }));
const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
// 结构化数据只描述页面上看得到的内容：课程列表 + 下面的“简短回答”
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'ItemList', name: '皮穿支学习路径', inLanguage: 'zh-CN',
      itemListElement: lessons.map((l, i) => ({ '@type': 'ListItem', position: i + 1, name: l.title, url: `${siteUrl()}${base}/xuexi/${l.slug}/` })) },
    { '@type': 'FAQPage', inLanguage: 'zh-CN',
      mainEntity: qa.answers.map((a) => ({ '@type': 'Question', name: a.q, acceptedAnswer: { '@type': 'Answer', text: a.a } })) },
  ],
};
const totalMin = lessons.reduce((n, l) => n + (l.minutes || 0), 0);
---
<Base title="皮穿支学习路径：从解剖到定位研究，按顺序学" path="/xuexi/" description="皮穿支学习路径：共 6 课，从皮穿支的解剖定义、组织层次、显微外科应用，到它与腧穴的研究进展和多普勒定位原理，按顺序学，每课都有下一步。" keywords={['皮穿支', '皮穿支学习', '什么是皮穿支', '皮穿支与穴位', '多普勒定位', site.brand]} jsonLd={jsonLd}>
  <div class="container" data-lp-root data-lp-lessons={JSON.stringify(order)}>
    <div class="breadcrumb"><a href={u('/')}>首页</a> › 皮穿支学习路径</div>
    <h1>皮穿支学习路径</h1>
    <p class="muted">共 {lessons.length} 课，约 {totalMin} 分钟。从“皮穿支是什么”讲起，到它在外科里怎么用、和腧穴的研究走到哪一步、多普勒怎么找。建议按顺序学，每一课读完都有“下一课”。</p>

    <div class="card lp-panel">
      <div class="lp-panel-row">
        <div>
          <div class="small muted">本机学习进度</div>
          <div class="lp-count"><strong data-lp-count>0 / {lessons.length}</strong> 课</div>
        </div>
        <a class="btn btn-lg" data-lp-continue href={u(`/xuexi/${lessons[0].slug}/`)}>从第 1 课开始</a>
      </div>
      <div class="lp-track" aria-hidden="true"><div class="lp-bar" data-lp-bar></div></div>
      <p class="small muted" style="margin:8px 0 0">进度只保存在这台设备的浏览器里，不需要登录；换手机、换浏览器或清理浏览器数据后会重新开始。<button type="button" class="linklike" data-lp-reset>清空进度</button></p>
    </div>

    <QuickAnswer ids={qa.answers.map((a) => a.id)} />

    <p class="small muted" style="margin-bottom:4px"><strong>课程目录</strong>（共 {lessons.length} 课）</p>
    <ol class="lp-list">
      {lessons.map((l, i) => (
        <li class="card lp-item">
          <div class="lp-num">{i + 1}</div>
          <div class="lp-body">
            <h2><a href={u(`/xuexi/${l.slug}/`)}>{l.title}</a></h2>
            <p>{l.description}</p>
            <div class="update-meta"><span class="badge badge-gray" data-lp-status={l.slug}>未学</span><span class="badge badge-gray">约 {l.minutes} 分钟</span></div>
          </div>
        </li>
      ))}
    </ol>

    <p class="small muted">皮穿支与腧穴的对应关系仍在持续研究中，课文按“解剖事实”和“研究进展”分开讲。</p>
    <p class="small muted">想按日期看新内容，可以去<a href={u('/learning/today/')}>今日学习</a>；想查具体穴位，可以去<a href={u('/xuewei/')}>穴位知识库</a>。</p>
  </div>
  <LessonProgress />
</Base>
