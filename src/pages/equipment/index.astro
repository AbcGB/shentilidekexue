---
import Base from '../../layouts/Base.astro';
import UpdateList from '../../components/UpdateList.astro';
import ReviewBadge from '../../components/ReviewBadge.astro';
import { equipment, getAcupointsOrdered, getLearning } from '../../lib/data';
import { u } from '../../lib/url';
const eq: any = equipment;
const points = getAcupointsOrdered();
const entries = getLearning().filter((e) => e.type === '设备演示');
---
<Base title="皮门多普勒定位演示：设备外观、探头与操作过程" path="/equipment/" description="皮门多普勒定位演示：丁老师研发的多普勒设备外观说明、探头介绍、操作流程与各穴位定位演示记录。只记录真实操作过程，不宣称百分之百精准或治疗效果。" keywords={['皮门多普勒', '多普勒定位演示', '穴位定位', '身体里的科学']}>
  <div class="container">
    <div class="breadcrumb"><a href={u('/')}>首页</a> › 设备演示</div>
    <h1>{eq.title}</h1>
    <div class="detail-meta"><ReviewBadge status={eq.reviewStatus} /><span class="small muted">更新时间：{eq.updateDate}</span></div>
    <p>{eq.intro}</p>
    <div class="notice"><strong>说明：</strong><ul style="margin:4px 0 0;padding-left:1.2em">{eq.statement.map((s: string) => <li>{s}</li>)}</ul></div>

    <section class="detail-section">
      <h2>设备整体介绍与外观</h2>
      <p>{eq.appearance.text}</p>
      <div class="table-wrap"><table><thead><tr><th>部件</th><th>外观描述</th></tr></thead><tbody>{eq.appearance.parts.map((x: any) => <tr><td>{x.name}</td><td>{x.desc}</td></tr>)}</tbody></table></div>
      {eq.photos.length > 0 ? (
        <div class="grid grid-2" style="margin-top:12px">{eq.photos.map((ph: any) => <figure style="margin:0"><img src={u(ph.src)} alt={ph.alt} loading="lazy" /><figcaption class="small muted">{ph.caption || ph.alt}</figcaption></figure>)}</div>
      ) : <div class="placeholder" style="margin-top:12px"><strong>设备照片：</strong>{eq.appearance.photoStatus}</div>}
    </section>

    <section class="detail-section">
      <h2>探头介绍</h2>
      <p>主机通过弹簧线连接黑色笔形探头，探头前端为圆形白色接触头。操作时将接触头轻放在体表并缓慢移动。探头的具体技术参数待研发人员确认。</p>
    </section>

    <section class="detail-section">
      <h2>操作展示</h2>
      <ol>{eq.operationSteps.map((s: string) => <li>{s}</li>)}</ol>
      <p class="small muted">以上为演示中的实际操作过程描述，设备技术原理、检测能力及适用范围以研发和技术人员的正式说明为准（待确认）。</p>
    </section>

    <section class="detail-section">
      <h2>多普勒提示音演示</h2>
      <div class="placeholder">{eq.soundDemo}</div>
    </section>

    <section class="detail-section">
      <h2>不同穴位的定位演示</h2>
      <div class="table-wrap"><table><thead><tr><th>穴位</th><th>经络</th><th>演示素材</th></tr></thead><tbody>
        {points.map((p: any) => <tr><td><a href={u(`/xuewei/${p.slug}/#doppler`)}>{p.displayName}</a></td><td>{p.meridian}</td><td>{p.dopplerDemo.videos?.length ? `${p.dopplerDemo.videos.length} 个视频` : '待提供'}</td></tr>)}
      </tbody></table></div>
      {eq.videos.length > 0 && <ul>{eq.videos.map((v: any) => <li><a href={v.url} target="_blank" rel="noopener">{v.title}</a></li>)}</ul>}
    </section>

    <section class="detail-section">
      <h2>相关学习资料</h2>
      <ul>{eq.materials.map((m: string) => <li>{m}</li>)}</ul>
      {entries.length > 0 && <><h3>演示更新记录</h3><UpdateList entries={entries} showDate /></>}
    </section>
  </div>
</Base>
