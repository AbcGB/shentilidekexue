---
import Base from '../layouts/Base.astro';
import Search from '../components/Search.astro';
import { u } from '../lib/url';
---
<Base title="搜索" path="/search/" noindex description="搜索穴位名称、拼音、经络和历史内容。">
  <div class="container">
    <div class="breadcrumb"><a href={u('/')}>首页</a> › 搜索</div>
    <h1>搜索</h1>
    <p class="muted small">支持穴位名称、部分文字、拼音（全拼或首字母）、经络名称，也能搜到历史学习内容。</p>
    <Search mode="page" autofocus />
  </div>
</Base>
