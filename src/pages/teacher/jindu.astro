---
import Base from '../../layouts/Base.astro';
import { getFilmingRows, filmingList } from '../../lib/data';
import { u } from '../../lib/url';
const rows = getFilmingRows();
const list: any = filmingList;
const S: Record<string, [string, string]> = { official: ['正式文案已确认', 'badge-ok'], draft: ['草稿待确认', 'badge-warn'], none: ['暂无文案', 'badge-gray'] };
const count = (k: string) => rows.filter((r) => r.copyStatus === k).length;
---
<Base title="全身经穴拍摄清单（老师工作台）" path="/teacher/jindu/" noindex description="内部页面：全身经穴定位视频拍摄清单与文案状态。">
  <div class="container">
    <div class="breadcrumb"><a href={u('/')}>首页</a> › <a href={u('/teacher/')}>老师工作台</a> › 拍摄清单</div>
    <h1>全身经穴拍摄清单</h1>
    <p class="muted">第一期：老师们为全身经穴各拍一条 20—30 秒的定位 + 皮门多普勒演示视频。这里列出每个穴位的文案状态，方便分工。<a href={u('/teacher/paishe/')}>拍摄建议 →</a></p>
    <p class="notice">名称、代码、所属经络依据 <strong>{list.source}</strong>。{list.complete ? '' : list.completeNote} 目前共 {rows.length} 个穴位。</p>
    <p class="small muted">正式文案已确认 {count('official')} 个 · 草稿待确认 {count('draft')} 个 · 暂无文案 {count('none')} 个。“视频”一栏只有在资料里登记过才会显示，否则为“未记录”。</p>

    <form class="filters" id="jd-f" onsubmit="return false">
      <label>经络<select name="meridian"><option value="">全部经络</option>{list.meridians.map((m: any) => <option value={m.name}>{m.name}（{m.code}）</option>)}</select></label>
      <label>文案状态<select name="status"><option value="">全部状态</option><option value="official">正式文案已确认</option><option value="draft">草稿待确认</option><option value="none">暂无文案</option></select></label>
      <label>查找<input name="q" type="search" placeholder="穴位名或代码" /></label>
    </form>
    <div class="table-wrap" style="margin-top:12px">
      <table id="jd-table">
        <thead><tr><th>穴位</th><th>代码</th><th>经络</th><th>文案</th><th>公开知识页</th><th>视频</th></tr></thead>
        <tbody>
          {rows.map((r) => (
            <tr data-meridian={r.meridian} data-status={r.copyStatus} data-q={`${r.name} ${r.code}`.toLowerCase()}>
              <td>{r.name}</td><td>{r.code}</td><td>{r.meridian}</td>
              <td>
                <span class={`badge ${S[r.copyStatus][1]}`}>{S[r.copyStatus][0]}</span>
                {r.copyStatus === 'official' && <> <a href={u(`/teacher/${r.slug}/`)}>打开工作台</a></>}
                {r.copyStatus === 'draft' && <> <a href={u(`/teacher/drafts/${r.slug}/`)}>查看草稿</a></>}
              </td>
              <td>{r.hasPublicPage ? <a href={u(`/xuewei/${r.slug}/`)}>有</a> : '无'}</td>
              <td class="muted">{r.videoStatus}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p id="jd-empty" class="placeholder" hidden>没有符合条件的穴位。</p>
    <p class="small muted">新增穴位：先在 <code>src/content/filming/acupoint-list.json</code> 的 points 里按标准原文加一条（名称、代码、经络）。清单里的穴位不会自动生成公开页面或正式文案；有了真实的穴位资料和负责人确认的文案，才分别加入知识库和工作台。</p>
  </div>
  <script>
    const f = document.getElementById('jd-f') as HTMLFormElement;
    const apply = () => {
      const m = (f.elements.namedItem('meridian') as HTMLSelectElement).value;
      const st = (f.elements.namedItem('status') as HTMLSelectElement).value;
      const q = (f.elements.namedItem('q') as HTMLInputElement).value.trim().toLowerCase();
      let n = 0;
      document.querySelectorAll<HTMLElement>('#jd-table tbody tr').forEach((tr) => {
        const show = (!m || tr.dataset.meridian === m) && (!st || tr.dataset.status === st) && (!q || tr.dataset.q!.includes(q));
        tr.hidden = !show; if (show) n++;
      });
      document.getElementById('jd-empty')!.hidden = n > 0;
    };
    f.addEventListener('input', apply); f.addEventListener('change', apply);
  </script>
</Base>
