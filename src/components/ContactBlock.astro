---
// 联系陈老师：微信、二维码、工作群入口。数据来自 src/config/site.json 的 contact，留空的项目不显示，不编造联系方式。
import { site } from '../lib/data';
import { u } from '../lib/url';
interface Props { heading?: string; headingLevel?: 2 | 3 }
const { heading = '联系陈老师', headingLevel = 2 } = Astro.props;
const c: any = site.contact || {};
const H = `h${headingLevel}`;
const hasDirect = !!(c.wechatId || c.wechatQr || c.groupQr || c.groupUrl || c.email);
---
<div class="card contact-block" data-contact-direct={hasDirect ? 'yes' : 'no'}>
  {heading && <H style="margin-top:0">{heading}</H>}
  <p class="contact-note" style="margin-top:0"><strong>{c.note || '如有内容建议、合作咨询或其他问题，请联系陈老师。'}</strong></p>
  {hasDirect && (
    <div class="contact-ways">
      {(c.wechatId || c.wechatQr) && (
        <div class="contact-way">
          <div class="pm-platform">添加{c.contactPerson || '陈老师'}微信</div>
          {c.wechatId && <div class="pm-name">微信号：<span class="selectable">{c.wechatId}</span></div>}
          {c.wechatQr && <img class="pm-qr" src={u(c.wechatQr)} alt={`${c.contactPerson || '陈老师'}微信二维码`} width="140" height="140" loading="lazy" />}
        </div>
      )}
      {(c.groupQr || c.groupUrl) && (
        <div class="contact-way">
          <div class="pm-platform">加入{c.groupName || '项目微信群'}</div>
          {c.groupQr && <img class="pm-qr" src={u(c.groupQr)} alt={`${c.groupName || '项目微信群'}二维码`} width="140" height="140" loading="lazy" />}
          {c.groupUrl && <a class="btn btn-sm btn-outline" href={c.groupUrl} target="_blank" rel="noopener">进入工作群</a>}
        </div>
      )}
      {c.email && <div class="contact-way"><div class="pm-platform">邮箱</div><div class="pm-name"><a href={`mailto:${c.email}`}>{c.email}</a></div></div>}
    </div>
  )}
  <p class="small muted" style="margin-bottom:0">已在「身体里的科学」工作群的老师，可以直接在群里 @陈老师。</p>
</div>
