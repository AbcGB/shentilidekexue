---
import Base from '../../layouts/Base.astro';
import CopyRuntime from '../../components/CopyRuntime.astro';
import ReviewBadge from '../../components/ReviewBadge.astro';
import { getWorkbenchAcupoints, copySettings, site } from '../../lib/data';
import { getSets, buildCopyMap, keywordsText, hashtagsText, buildCopyItems, variantKey, longCopyOf } from '../../lib/copy-core.mjs';
import { u } from '../../lib/url';

export function getStaticPaths() {
  return getWorkbenchAcupoints().map((p: any) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as any;
const sets = getSets(p);
const main = sets[0];
const map = buildCopyMap(p, copySettings);
const art = longCopyOf(p);
const items = buildCopyItems(p, copySettings);
const idByKey = Object.fromEntries(items.map((it: any) => [it.copyKey, it.id]));
const statsCfg = { enabled: site.stats?.enabled !== false, apiBase: site.stats?.apiBase || '/api', acupoint: p.slug };
const fields = [
  { key: 'title', label: '标题', btn: '复制标题', text: (v: any) => v.title },
  { key: 'description', label: '描述', btn: '复制描述', text: (v: any) => v.description },
  { key: 'keywords', label: '关键词', btn: '复制关键词', text: (v: any) => keywordsText(v, copySettings) },
  { key: 'hashtags', label: '话题标签', btn: '复制话题', text: (v: any) => hashtagsText(v, copySettings) },
];
---
<Base title={`${p.displayName} · ${main.variants.length} 组视频文案（老师工作台）`} path={`/teacher/${p.slug}/`} noindex description="内部使用的发布文案工作台。">
  <div class="container">
    <div class="breadcrumb"><a href={u('/')}>首页</a> › <a href={u('/teacher/')}>老师工作台</a> › {p.displayName}</div>
    <h1>{p.displayName} · {main.variants.length} 组视频文案</h1>
    <p class="muted small">{p.meridian} · 文案更新：{p.updateDate} · 穴位资料：<a href={u(`/xuewei/${p.slug}/`)}>查看公开页面</a></p>
    <p class="notice"><strong>{p.copyStatus || '请人工确认后再发布'}。</strong>标题、描述、关键词按负责人提供的原文录入，复制到的就是原文；穴位知识状态：<ReviewBadge status={p.reviewStatus} />。</p>
    <p class="small muted">用法：同一条视频，每位老师挑<strong>一组</strong>发布，标题、描述、关键词可以单独复制，也可以整组复制。大家尽量发不同的组（优先挑复制次数少的），搜索时能覆盖更多问法，也避免很多账号发同一句话。</p>
    <p class="small muted" id="stats-status">复制次数为全站老师共享的匿名统计（不记录是谁复制），正在读取统计…</p>

    {sets.map((set: any, si: number) => (
      <section class="wb-set" data-set={set.id}>
        {si > 0 && <h2 class="wb-set-title">另一条视频：{set.label}</h2>}
        {si === 0 && <h2 class="wb-set-title">{set.label}</h2>}
        {set.note && <p class="small muted">{set.note}</p>}
        <div class="wb-top">
          <div><strong>复制这条视频的全部 {set.variants.length} 组</strong><div class="small muted">方便负责人发到工作群</div></div>
          <div class="wb-side">
            <button class="btn" type="button" data-copy-key={`set:${set.id}`} data-item-id={idByKey[`set:${set.id}`]}>复制全部 {set.variants.length} 组</button>
            <div class="wb-stat" data-stat-for={idByKey[`set:${set.id}`]}>累计 <b data-t>–</b> 次 · 近7天 <b data-d7>–</b> 次</div>
          </div>
        </div>
        {set.variants.length > 1 && (
          <div class="wb-sort wb-sort-bar">
            <label class="small muted" for={`sort-${set.id}`}>排列顺序</label>
            <select id={`sort-${set.id}`} data-sort-select={set.id}>
              <option value="t-asc">复制少的在前（默认）</option>
              <option value="index">按编号 1、2、3……</option>
              <option value="d7-asc">近7天复制少的在前</option>
              <option value="t-desc">复制多的在前</option>
            </select>
          </div>
        )}
        <div class="wb-cards" data-cards={set.id}>
          {set.variants.map((v: any) => {
            const k = variantKey(set.id, v.id);
            const members = fields.map((f) => idByKey[`${f.key}:${k}`]).filter(Boolean);
            return (
              <article class="wb-group wb-card" data-variant={v.id} data-index={v.no} data-members={members.join(' ')}>
                <div class="wb-head">
                  <h3 class="wb-card-title"><span class="wb-no">{v.no}</span><span class="wb-angle">第 {v.no} 组{v.angle ? `：${v.angle}` : ''}</span></h3>
                  <div class="wb-side">
                    <button class="btn" type="button" data-copy-key={`group:${k}`} data-item-id={idByKey[`group:${k}`]}>复制整组</button>
                    <div class="wb-stat" data-stat-for={idByKey[`group:${k}`]}>整组 累计 <b data-t>–</b> 次 · 近7天 <b data-d7>–</b> 次</div>
                  </div>
                </div>
                {fields.map((f) => {
                  const text = f.text(v);
                  const itemId = idByKey[`${f.key}:${k}`];
                  if (!text) return null;
                  return (
                    <div class="wb-row" data-item-id={itemId}>
                      <div>
                        <div class="wb-acc">{f.label}</div>
                        <div class="wb-text" data-field={f.key}>{text}</div>
                      </div>
                      <div class="wb-side">
                        <button class="btn btn-outline" type="button" data-copy-key={`${f.key}:${k}`} data-item-id={itemId}>{f.btn}</button>
                        <div class="wb-stat" data-stat-for={itemId}>累计 <b data-t>–</b> 次<br />近7天 <b data-d7>–</b> 次</div>
                      </div>
                    </div>
                  );
                })}
              </article>
            );
          })}
        </div>
      </section>
    ))}

    {art?.body && art.showInWorkbench && (
      <section class="wb-group" data-group="long">
        <h2>长文案（可选）</h2>
        <div class="wb-row"><div><div class="wb-acc">状态</div><div class="wb-text"><span class="badge badge-warn">{art.status}</span> 适合需要长正文的地方使用，没有需要可以不用。</div></div></div>
        {[
          ['title', '标题', art.title], ['summary', '摘要', art.summary], ['keywords', '关键词', map['long:keywords']],
          ['coverTitle', '封面标题', art.coverTitle], ['coverImageSuggestion', '封面图片建议', art.coverImageSuggestion], ['body', '正文（Markdown 格式）', art.body],
        ].map(([k, label, val]) => (
          <div class="wb-row">
            <div><div class="wb-acc">{label}</div><div class="wb-text">{val}</div></div>
            <button class="btn btn-outline" type="button" data-copy-key={`long:${k}`}>复制{label.replace(/（.*）/, '')}</button>
          </div>
        ))}
      </section>
    )}

    <p class="small muted">提示：如果按钮无法复制，会弹出文字框，请手动全选复制（手动复制无法确认是否成功，因此不计入次数）。也可以直接长按上面的文字进行选择。</p>
    <p class="small muted">统计规则：单项复制只增加该项次数；“复制整组”增加该组整组次数，同时该组的标题、描述、关键词、话题标签各加一次；“复制全部 N 组”只记一次整批复制，不计入各单项。同一浏览器 10 秒内重复复制同一内容只计一次。“复制少的在前”按每组标题、描述、关键词的累计次数之和排列。</p>
    <script type="application/json" id="stats-config" set:html={JSON.stringify(statsCfg)} />
    <script type="application/json" id="copy-data" set:html={JSON.stringify(map).replace(/</g, '\\u003c')} />
  </div>
  <CopyRuntime />
</Base>
