---
import Base from '../../layouts/Base.astro';
import PointCard from '../../components/PointCard.astro';
import Search from '../../components/Search.astro';
import { getAcupointsOrdered } from '../../lib/data';
import { u } from '../../lib/url';
const points = getAcupointsOrdered();
const meridians = Array.from(new Set(points.map((p: any) => p.meridian)));
---
<Base title="人体穴位知识中心：穴位位置、取穴方法与定位演示" path="/xuewei/" description="身体里的科学·人体穴位知识库：按经络整理足三里、阳陵泉、三阴交、外关、后溪、神门等常用穴位的标准位置、简便找法与传统经络知识。">
  <div class="container">
    <div class="breadcrumb"><a href={u('/')}>首页</a> › 穴位知识中心</div>
    <h1>人体穴位知识中心</h1>
    <p class="muted">目前收录 {points.length} 个穴位，持续增加中。每个穴位都有独立页面，包含所属经络、标准定位、取穴方法、传统功能与主治、皮门多普勒定位演示和参考资料，逐步建成全身标准经穴知识库。</p>
    <p class="small muted">标准定位依据国家标准 GB/T 12346-2021《经穴名称与定位》和针灸教材；定位演示由参与老师用皮门多普勒实际操作拍摄，陆续补充。</p>
    <div style="margin:16px 0"><Search mode="live" /></div>
    <h2>全部穴位</h2>
    <div class="grid grid-3">{points.map((p) => <PointCard p={p} />)}</div>
    <h2>按经络浏览</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th>经络</th><th>穴位</th></tr></thead>
        <tbody>
          {meridians.map((m) => (
            <tr><td>{m}</td><td>{points.filter((p: any) => p.meridian === m).map((p: any, i: number) => <>{i > 0 && '、'}<a href={u(`/xuewei/${p.slug}/`)}>{p.displayName}</a></>)}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</Base>
