---
import Base from '../../layouts/Base.astro';
import { hasWorkbenchCopies } from '../../lib/copy-core.mjs';
import { getAcupoints, getArticle, getLearning, site, siteUrl } from '../../lib/data';
import { u } from '../../lib/url';

export function getStaticPaths() {
  return getAcupoints().map((p: any) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as any;
const all = getAcupoints();
const article = getArticle(p.publicArticle || p.slug);
const Content = article?.Content;
const related = (p.relatedSlugs || []).map((s: string) => all.find((x: any) => x.slug === s)).filter(Boolean);
const entries = getLearning().filter((e) => (e.acupoints || []).includes(p.slug));
const path = `/xuewei/${p.slug}/`;
// 只有真实填写的作者/参与老师才对外展示；内部审核状态（reviewStatus、reviewer）不在公开页面显示，见 /teacher/shenhe/
const realName = (s: any) => typeof s === 'string' && s.trim() && !/^待/.test(s.trim());
const authors: { name: string; bio?: string }[] = [
  ...(Array.isArray(p.contributors) ? p.contributors : []),
  ...(realName(p.author) ? [{ name: p.author, bio: p.authorBio }] : []),
].filter((a: any) => realName(a?.name));
const demoPhotos = p.dopplerDemo?.photos || [];
const demoVideos = p.dopplerDemo?.videos || [];
const hasDemo = demoPhotos.length > 0 || demoVideos.length > 0;
const hasMedia = (p.videos || []).length > 0 || (p.images || []).length > 0;
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: p.seo.title, description: p.seo.description, inLanguage: 'zh-CN',
  datePublished: p.publishDate, dateModified: p.updateDate,
  mainEntityOfPage: siteUrl() + path,
  publisher: { '@type': 'Organization', name: site.siteName },
  ...(authors.length ? { author: authors.map((a) => ({ '@type': 'Person', name: a.name })) } : {}),
};
---
<Base title={p.seo.title} description={p.seo.description} path={path} ogType="article" updated={p.updateDate} keywords={p.seo.keywords} jsonLd={jsonLd}>
  <div class="container">
    <div class="breadcrumb"><a href={u('/')}>首页</a> › <a href={u('/xuewei/')}>穴位知识中心</a> › {p.displayName}</div>
    <header class="detail-head">
      <h1>{p.displayName}</h1>
      <div class="detail-meta">
        <span class="badge">{p.meridian}</span>
        <span class="badge badge-gray">{p.code}</span>
        {p.specialPointCategories.map((c: string) => <span class="badge badge-gray">{c}</span>)}
      </div>
      <p class="muted small">拼音：{p.pinyin} · 别名/代码：{p.aliases.join('、')} · 更新时间：<time datetime={p.updateDate}>{p.updateDate}</time></p>
      <p class="lead">{p.summary}</p>
      <nav class="toc" aria-label="本页目录">
        <a href="#meridian">所属经络</a><a href="#location">标准定位</a><a href="#finding">取穴方法</a><a href="#applications">传统功能与主治</a><a href="#doppler">定位演示</a><a href="#knowledge">相关知识</a><a href="#sources">参考资料</a>
        {hasWorkbenchCopies(p) && <a href={u(`/teacher/${p.slug}/`)} style="background:var(--blue-soft)">老师工作台：复制发布文案</a>}
      </nav>
    </header>

    <section class="detail-section" id="meridian">
      <h2>所属经络</h2>
      <p><strong>{p.meridian}</strong>（{p.code}）。在针灸教材中归为：{p.specialPointCategories.join('、')}。</p>
      {p.nameOrigin && <p>{p.nameOrigin}</p>}
    </section>

    <section class="detail-section" id="location">
      <h2>{p.name}在哪里？标准定位</h2>
      <div class="std-box"><strong>标准定位：</strong>{p.standardLocation.standard}<br /><span class="small">（依据：{p.standardLocation.standardSource}）</span></div>
      <h3>通俗说法</h3>
      <p>{p.standardLocation.plain}</p>
      <h3 id="finding">取穴方法</h3>
      <ol>{p.standardLocation.findingTips.map((t: string) => <li>{t}</li>)}</ol>
    </section>

    <section class="detail-section" id="applications">
      <h2>传统功能与主治</h2>
      <p>{p.traditionalApplications.intro}</p>
      <ul>{p.traditionalApplications.items.map((t: string) => <li>{t}</li>)}</ul>
      {p.traditionalApplications.note && <p class="small muted">{p.traditionalApplications.note}</p>}
      {p.cautions?.length > 0 && <><h3>操作要点</h3><ul>{p.cautions.map((t: string) => <li>{t}</li>)}</ul></>}
    </section>

    <section class="detail-section" id="doppler">
      <h2>皮门多普勒定位演示</h2>
      <p>定位过程：先按标准定位找到{p.name}的大致区域，再把皮门多普勒探头轻放在体表缓慢移动，观察显示屏信号和提示音的变化，在变化明显的位置做定位标记。<a href={u('/equipment/')}>了解皮门多普勒设备 →</a></p>
      {hasDemo ? (
        <div class="grid grid-2">
          {demoPhotos.map((ph: any) => <figure style="margin:0"><img src={u(ph.src)} alt={ph.alt} loading="lazy" /><figcaption class="small muted">{ph.caption || ph.alt}</figcaption></figure>)}
          {demoVideos.map((v: any) => <a class="card" href={v.url} target="_blank" rel="noopener">▶ {v.title}</a>)}
        </div>
      ) : (
        <div class="placeholder small"><strong>定位演示视频：素材待提供。</strong>{p.dopplerDemo?.note}</div>
      )}
      {hasMedia && (
        <div class="grid grid-2" style="margin-top:12px">
          {p.images.map((im: any) => <figure style="margin:0"><img src={u(im.src)} alt={im.alt} loading="lazy" /><figcaption class="small muted">{im.caption || im.alt}</figcaption></figure>)}
          {p.videos.map((v: any) => <a class="card" href={v.url} target="_blank" rel="noopener">▶ {v.title}</a>)}
        </div>
      )}
      {p.videoText && <details style="margin-top:10px"><summary>视频口播 / 字幕参考稿</summary><p style="white-space:pre-wrap">{p.videoText}</p></details>}
    </section>

    <section class="detail-section prose" id="knowledge">
      <h2>相关知识</h2>
      {Content ? <Content /> : <p class="muted">相关知识持续补充中。</p>}
      {related.length > 0 && <>
        <h3>本站相关穴位</h3>
        <ul>{related.map((r: any) => <li><a href={u(`/xuewei/${r.slug}/`)}>{r.displayName}</a>（{r.meridian}）</li>)}</ul>
      </>}
      {entries.length > 0 && <>
        <h3>相关更新</h3>
        <ul>{entries.map((e) => <li>{e.date} · {e.type} · <a href={u(`/learning/archive/#${e.id}`)}>{e.title}</a></li>)}</ul>
      </>}
    </section>

    {authors.length > 0 && (
      <section class="detail-section" id="authors">
        <h2>参与老师</h2>
        <ul>{authors.map((a) => <li><strong>{a.name}</strong>{a.bio && <>：{a.bio}</>}</li>)}</ul>
      </section>
    )}

    <section class="detail-section" id="sources">
      <h2>参考资料</h2>
      <ul>{p.sources.map((s: any) => <li>{s.title}{s.note && <span class="small muted">（{s.note}）</span>}</li>)}</ul>
      <p class="small muted">发现内容有误或有补充建议，欢迎<a href={u('/contact/')}>联系陈老师</a>。</p>
    </section>

    <nav class="toc" aria-label="其他穴位">
      {all.filter((x: any) => x.slug !== p.slug).map((x: any) => <a href={u(`/xuewei/${x.slug}/`)}>{x.displayName}</a>)}
    </nav>
  </div>
</Base>
